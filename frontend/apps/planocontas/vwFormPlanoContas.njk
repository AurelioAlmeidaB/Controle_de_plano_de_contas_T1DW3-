<!-- Arquivo: ./apps/planocontas/vwFormPlanoContas.njk -->

{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2">Formulário do plano de contas</h1>
    <p class="text-secondary mb-0">Manipule os dados das contas de receita e despesa.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="mb-4">
        <h2 class="h5 fw-semibold mb-1">Dados da conta</h2>
        <p class="text-secondary mb-0">Informe os dados para inserir, atualizar ou remover uma conta.</p>
      </div>

      <form id="frmPlanoContas" data-servidor-dw3="{{ servidorDw3 }}">
        <input type="hidden" id="planocontaid" name="planocontaid" value="0">

        <div class="row g-3">
          <div class="col-12 col-md-4">
            <label for="codigo" class="form-label">Código</label>
            <input type="text" class="form-control" id="codigo" name="codigo" value="" maxlength="20" placeholder="Ex.: 1.1.01" required>
          </div>

          <div class="col-12 col-md-8">
            <label for="descricao" class="form-label">Descrição</label>
            <input type="text" class="form-control" id="descricao" name="descricao" value="" maxlength="80" required>
          </div>

          <div class="col-12 col-md-4">
            <label for="tipo" class="form-label">Tipo</label>
            <select class="form-select" id="tipo" name="tipo" required>
              <option value="">Selecione o tipo</option>
              <option value="Receita">Receita</option>
              <option value="Despesa">Despesa</option>
            </select>
          </div>

          <div class="col-12">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="ativo" name="ativo" checked>
              <label class="form-check-label" for="ativo">Ativo</label>
            </div>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="button" class="btn btn-primary d-none" id="btnInserirPlanoConta">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarPlanoConta">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverPlanoConta">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/planocontas" id="btnFecharPlanoConta">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/planocontas/vwFormPlanoContas.js"></script>
{% endblock %}
