{% extends "layout.njk" %}

{% block content %}
  <header class="page-header">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a href="/planocontas">Plano de Contas</a></li>
        <li class="breadcrumb-item active" aria-current="page" id="tituloOperacao">Formulário</li>
      </ol>
    </nav>
    <h1 class="h3 fw-bold mb-2">Formulário do plano de contas</h1>
    <p class="text-secondary mb-0">Manipule os dados das contas de receita e despesa.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div id="planoContaAlert" class="alert d-none" role="alert"></div>

      <form id="frmPlanoContas" data-servidor-dw3="{{ servidorDw3 }}">
        <input type="hidden" id="planocontaid" name="planocontaid" value="0">

        <div class="row g-3">
          <div class="col-12 col-md-3">
            <label for="codigo" class="form-label">Código <span class="obrigatorio">*</span></label>
            <input type="text" class="form-control" id="codigo" name="codigo" maxlength="20"
              placeholder="Ex.: 1.1.01" required>
          </div>

          <div class="col-12 col-md-9">
            <label for="descricao" class="form-label">Descrição <span class="obrigatorio">*</span></label>
            <input type="text" class="form-control" id="descricao" name="descricao" maxlength="80"
              placeholder="Ex.: Venda de produtos" required>
          </div>

          <div class="col-12 col-md-4">
            <label for="tipo" class="form-label">Tipo <span class="obrigatorio">*</span></label>
            <select class="form-select" id="tipo" name="tipo" required>
              <option value="">Selecione o tipo</option>
              <option value="Receita">Receita</option>
              <option value="Despesa">Despesa</option>
            </select>
          </div>

          <div class="col-12 col-md-4 d-flex align-items-end">
            <div class="form-check form-switch mb-2">
              <input class="form-check-input" type="checkbox" role="switch" id="ativo" name="ativo" checked>
              <label class="form-check-label" for="ativo">Conta ativa</label>
            </div>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="submit" class="btn btn-primary d-none" id="btnInserirPlanoConta">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="submit" class="btn btn-warning d-none" id="btnAtualizarPlanoConta">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverPlanoConta">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/planocontas" id="btnFecharPlanoConta">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/apps/planocontas/vwFormPlanoContas.js"></script>
{% endblock %}
