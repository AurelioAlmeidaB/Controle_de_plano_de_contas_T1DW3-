<!-- Arquivo: ./apps/lancamentos/vwFormLancamentos.njk -->

{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css">

  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Movimentação</p>
    <h1 class="h3 fw-bold mb-2">Formulário de lançamentos</h1>
    <p class="text-secondary mb-0">Manipule os lançamentos financeiros de cada conta.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="mb-4">
        <h2 class="h5 fw-semibold mb-1">Dados do lançamento</h2>
        <p class="text-secondary mb-0">Informe os dados para inserir, atualizar ou remover um lançamento.</p>
      </div>

      <form id="frmLancamentos" data-servidor-dw3="{{ servidorDw3 }}">
        <input type="hidden" id="lancamentoid" name="lancamentoid" value="0">

        <div class="row g-3">
          <div class="col-12">
            <label for="descricao" class="form-label">Descrição</label>
            <input type="text" class="form-control" id="descricao" name="descricao" value="" maxlength="100" required>
          </div>

          <div class="col-12 col-md-6">
            <label for="planocontaid" class="form-label">Conta</label>
            <select class="form-select" id="planocontaid" name="planocontaid" required>
              <option value="">Selecione uma conta</option>
            </select>
          </div>

          <div class="col-12 col-md-3">
            <label for="valor" class="form-label">Valor</label>
            <input type="number" class="form-control" id="valor" name="valor" min="0.01" step="0.01" value="" required>
          </div>

          <div class="col-12 col-md-3">
            <label for="datalancamento" class="form-label">Data</label>
            <input type="date" class="form-control" id="datalancamento" name="datalancamento" value="" required>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="button" class="btn btn-primary d-none" id="btnInserirLancamento">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarLancamento">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverLancamento">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/lancamentos" id="btnFecharLancamento">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="/apps/lancamentos/vwFormLancamentos.js"></script>
{% endblock %}
