{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css">

  <header class="page-header">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a href="/lancamentos">Lançamentos</a></li>
        <li class="breadcrumb-item active" aria-current="page" id="tituloOperacao">Formulário</li>
      </ol>
    </nav>
    <h1 class="h3 fw-bold mb-2">Formulário de lançamentos</h1>
    <p class="text-secondary mb-0">Manipule os lançamentos financeiros vinculados ao plano de contas.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div id="lancamentoAlert" class="alert d-none" role="alert"></div>

      <form id="frmLancamentos" data-servidor-dw3="{{ servidorDw3 }}">
        <input type="hidden" id="lancamentoid" name="lancamentoid" value="0">

        <div class="row g-3">
          <div class="col-12">
            <label for="descricao" class="form-label">Descrição <span class="obrigatorio">*</span></label>
            <input type="text" class="form-control" id="descricao" name="descricao" maxlength="100"
              placeholder="Ex.: Conta de energia - outubro" required>
          </div>

          <div class="col-12 col-md-6">
            <label for="planocontaid" class="form-label">Conta do plano de contas <span class="obrigatorio">*</span></label>
            <select class="form-select" id="planocontaid" name="planocontaid" required>
              <option value="">Selecione uma conta</option>
            </select>
          </div>

          <div class="col-12 col-md-3">
            <label for="valor" class="form-label">Valor (R$) <span class="obrigatorio">*</span></label>
            <input type="number" class="form-control" id="valor" name="valor" min="0.01" step="0.01"
              placeholder="0,00" required>
          </div>

          <div class="col-12 col-md-3">
            <label for="datalancamento" class="form-label">Data <span class="obrigatorio">*</span></label>
            <input type="date" class="form-control" id="datalancamento" name="datalancamento" required>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="submit" class="btn btn-primary d-none" id="btnInserirLancamento">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="submit" class="btn btn-warning d-none" id="btnAtualizarLancamento">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverLancamento">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/lancamentos" id="btnFecharLancamento">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="/apps/lancamentos/vwFormLancamentos.js"></script>
{% endblock %}
