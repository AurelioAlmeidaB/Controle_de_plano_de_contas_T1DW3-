<!-- views/error.njk -->

{% extends "layout.njk" %}

{% block content %}
  <header class="page-header">
    <p class="page-kicker text-danger fw-semibold mb-2">Erro</p>
    <h1 class="h3 fw-bold mb-2">{{ message }}</h1>
    {% if error.status %}<p class="text-secondary mb-0">Código {{ error.status }}</p>{% endif %}
  </header>

  <a class="btn btn-primary" href="/home">Voltar para o início</a>
{% endblock %}
