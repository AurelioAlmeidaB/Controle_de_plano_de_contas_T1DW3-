<!-- views/home.njk -->

{% extends "layout.njk" %}

{% block content %}
  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Módulo Financeiro</p>
    <h1 class="display-6 fw-bold mb-2">Painel principal</h1>
    <p class="text-secondary mb-0">Resumo dos lançamentos e acesso rápido aos cadastros.</p>
  </header>

  <div id="homeAlert" class="alert d-none" role="alert"></div>

  <div class="row g-3 mb-4" id="homeResumo" data-servidor-dw3="{{ servidorDw3 }}">
    <div class="col-12 col-md-4">
      <div class="card resumo-card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="text-secondary small mb-1"><i class="bi bi-arrow-down-circle text-success me-1"></i>Total de receitas</p>
          <p class="resumo-valor text-success mb-0" id="totalReceitas">—</p>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="card resumo-card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="text-secondary small mb-1"><i class="bi bi-arrow-up-circle text-danger me-1"></i>Total de despesas</p>
          <p class="resumo-valor text-danger mb-0" id="totalDespesas">—</p>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="card resumo-card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="text-secondary small mb-1"><i class="bi bi-wallet2 me-1"></i>Saldo</p>
          <p class="resumo-valor mb-0" id="totalSaldo">—</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-md-6">
      <a class="card modulo-card border-0 shadow-sm h-100 text-decoration-none text-reset" href="/planocontas">
        <div class="card-body p-4 d-flex gap-3 align-items-start">
          <i class="bi bi-list-columns-reverse modulo-icon"></i>
          <div>
            <h2 class="h5 fw-semibold mb-1">Plano de Contas</h2>
            <p class="text-secondary mb-0">Cadastre as contas de receita e despesa da cooperativa.</p>
          </div>
        </div>
      </a>
    </div>
    <div class="col-12 col-md-6">
      <a class="card modulo-card border-0 shadow-sm h-100 text-decoration-none text-reset" href="/lancamentos">
        <div class="card-body p-4 d-flex gap-3 align-items-start">
          <i class="bi bi-cash-stack modulo-icon"></i>
          <div>
            <h2 class="h5 fw-semibold mb-1">Lançamentos</h2>
            <p class="text-secondary mb-0">Registre as movimentações financeiras em cada conta.</p>
          </div>
        </div>
      </a>
    </div>
  </div>

  <script src="/apps/home/vwHome.js"></script>
{% endblock %}
