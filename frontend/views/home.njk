<!--views/home.njk -->

{% extends "layout.njk" %}

{% block content %}
  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Módulo financeiro</p>
    <h1 class="display-6 fw-bold mb-2">Painel principal</h1>
    <p class="text-secondary mb-0">Use a navegação superior para acessar o plano de contas, os lançamentos ou sair da aplicação.</p>
  </header>

  <div class="hero-card card border-0 shadow-sm">
    <div class="card-body p-4 p-lg-5">
      <div class="row g-4 align-items-center">
        <div class="col-lg-8">
          <h2 class="h4 fw-semibold mb-3">Bem-vindo ao sistema</h2>
          <p class="text-secondary mb-0">Cadastre as contas de receita e despesa e registre os lançamentos da cooperativa.</p>
        </div>
        <div class="col-lg-4 d-flex flex-column gap-2">
          <a class="btn btn-primary" href="/planocontas">Ir para plano de contas</a>
          <a class="btn btn-outline-primary" href="/lancamentos">Ir para lançamentos</a>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/home/vwHome.js"></script>
{% endblock %}
